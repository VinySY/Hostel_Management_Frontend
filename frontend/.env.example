# Spring Boot REST API Base URL (e.g. http://localhost:8080/api in dev, https://<render-service>.onrender.com/api in prod)
VITE_API_BASE_URL=http://localhost:8080/api

# Connect to the live Spring Boot backend instead of local mock data (forced true in production builds)
VITE_USE_REAL_BACKEND=true

# Enable the development-only Fast Demo Access bar on the login page (never active in production builds)
VITE_ENABLE_DEMO_LOGIN=true

# App Configuration
VITE_APP_NAME=HostelSync
VITE_APP_ENV=development
